[Unit]
Description=Velo Client server (API for the game, the launcher and velo-client.com)
After=network-online.target
Wants=network-online.target

[Service]
User=velo-server
Group=velo
WorkingDirectory=/opt/velo/server
EnvironmentFile=/etc/velo/server.env
Environment=VELO_DATA_DIR=/opt/velo/server/data
Environment=VELO_SERVER_BIND=127.0.0.1
Environment=VELO_SERVER_PORT=8787
ExecStart=/usr/bin/java -Xms128m -Xmx768m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -jar /opt/velo/server/velo-server.jar
Restart=always
RestartSec=5
UMask=0007
LimitNOFILE=65536
# Hardening: read-only system, its own /tmp, no privilege changes; it may only write its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/velo/server/data
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=1200M

[Install]
WantedBy=multi-user.target
