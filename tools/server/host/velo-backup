#!/usr/bin/env bash
# Nightly backup of everything Velo keeps: server data (SQLite copied safely while running), bot data, the website.
# Keeps 3 days in /opt/velo/backups (the owner panel can download them). Secrets (/etc/velo) are NOT included.
# The download mirror (/var/www/velo-client.com/dl, ~2.6 GB of installers per release) is NOT backed up: it is a copy
# of the GitHub releases and tools/release/mirror_release.sh rebuilds it. Backing it up made each backup 15 GB and
# filled the disk (2026-11).
set -euo pipefail
umask 027
DEST=/opt/velo/backups
STAMP=$(date +%Y-%m-%d_%H%M)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/server-data"
# Live SQLite databases through the backup API (consistent even while velo-server writes).
for db in /opt/velo/server/data/*.db; do
	[ -e "$db" ] || continue
	python3 -I -c 'import sqlite3,sys; s=sqlite3.connect("file:"+sys.argv[1]+"?mode=ro", uri=True); d=sqlite3.connect(sys.argv[2]); s.backup(d); d.close(); s.close()' "$db" "$WORK/server-data/$(basename "$db")"
done
# Tester installers (data/tester/builds, ~4 GB per build) are NOT backed up either: CI rebuilds them from the tester-<v>
# tag. They made every backup 4.4 GB (2026-11-23..25).
tar -C /opt/velo/server/data --exclude='*.db' --exclude='*.db-wal' --exclude='*.db-shm' --exclude='./tester/builds' -cf - . | tar -C "$WORK/server-data" -xf -
tar -C "$WORK" -czf "$DEST/velo-$STAMP.tar.gz" server-data -C /opt/velo/bot bot-data -C /var/www --exclude='velo-client.com/dl' velo-client.com
chgrp velo "$DEST/velo-$STAMP.tar.gz"
chmod 640 "$DEST/velo-$STAMP.tar.gz"
find "$DEST" -name 'velo-*.tar.gz' -mtime +2 -delete
# empty / broken archives from a failed run (a full disk) never count as a backup
find "$DEST" -name 'velo-*.tar.gz' -size -1k -mmin +60 -delete
# Everything else that piles up here (copies made by deploys and hand edits: jars, configs, firewall rules): the newest
# 3 of each kind, nothing older than 14 days. Old env backups in /etc/velo: 30 days, newest 3 kept.
for kind in $(ls -1 "$DEST" | { grep -v '^velo-[0-9].*\.tar\.gz$' || true; } | sed -E 's/[.-]?(pre-[a-z-]+|[0-9]{8}-[0-9]{6}|[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}|[0-9]{8}-[0-9]{4}|[0-9]{10})$//' | sort -u); do
	{ ls -1t "$DEST"/"$kind"* 2>/dev/null || true; } | { grep -v '\.tar\.gz$' || true; } | tail -n +4 | xargs -r rm -f --
done
find "$DEST" -maxdepth 1 -type f ! -name 'velo-*.tar.gz' -mtime +14 -delete
for f in $({ ls -1t /etc/velo/*.bak* 2>/dev/null || true; } | tail -n +4); do
	find "$f" -maxdepth 0 -mtime +30 -delete 2>/dev/null || true
done
echo "backup $DEST/velo-$STAMP.tar.gz $(du -h "$DEST/velo-$STAMP.tar.gz" | cut -f1)"
