			"net.veloclient.legacy.VeloLegacy"
		]
	},
	"mixins": [
		"velo-legacy.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "1.8.9",
		"osl-entrypoints": ">=0.4.0",
